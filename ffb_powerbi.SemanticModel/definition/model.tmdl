model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["fact_branch_year","dim_county","dim_market","dim_owner","dim_year"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode"]

ref table fact_branch_year
ref table dim_county
ref table dim_market
ref table dim_owner
ref table dim_year

ref cultureInfo en-US

