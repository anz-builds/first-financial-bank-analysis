		summarizeBy: sum
		sourceColumn: deposits_000

		annotation SummarizationSetBy = Automatic

	column is_main_office
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: fde5d7c1-d23c-49b2-84e2-66ed25a214d9
		summarizeBy: none
		sourceColumn: is_main_office

		annotation SummarizationSetBy = Automatic

	column bank_class
		dataType: string
		lineageTag: e6d4d943-bc03-44ec-83dc-9e10b8b87d6a
		summarizeBy: none
		sourceColumn: bank_class

