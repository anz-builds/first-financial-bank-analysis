		annotation SummarizationSetBy = Automatic

	column deposits_capped_000
		dataType: double
		lineageTag: 9fc27c23-e603-4427-b6d9-2d6181325ac4
		summarizeBy: sum
		sourceColumn: deposits_capped_000

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column booking_status
		dataType: string
		lineageTag: 3c730edb-0762-4dd3-a893-7633fafe5f57
		summarizeBy: none
		sourceColumn: booking_status

		annotation SummarizationSetBy = Automatic

	column deposits_adjusted_000
		dataType: double
		lineageTag: e604aca1-4f41-4740-8dd0-7080fb8a532c
		summarizeBy: sum
		sourceColumn: deposits_adjusted_000

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Display label for booking_status (capitalized). The source value from clean.py stays unchanged.
	column 'Booking Status' =
			SWITCH (
			    fact_branch_year[booking_status],
			    "not flagged", "Not flagged",
			    "not reviewed", "Not reviewed",
			    "kept", "Kept",
			    "excluded", "Excluded",
			    "manual booking cap", "Manual booking cap",
			    fact_branch_year[booking_status]
			)
		dataType: string
		lineageTag: 70b5edcb-c294-48da-b2e5-7d7cf342b8a1
		summarizeBy: none

	partition fact_branch_year = m
		mode: import
		source =
				let
				  Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/anz-builds/first-financial-bank-analysis/main/data/clean/fact_branch_year.csv"), [Delimiter = ",", Columns = 15, Encoding = 65001]),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Changed column type" = Table.TransformColumnTypes(#"Promoted headers", {{"year", Int64.Type}, {"branch_id", Int64.Type}, {"cert", Int64.Type}, {"county_fips", Int64.Type}, {"market_id", type text}, {"deposits_000", Int64.Type}, {"is_main_office", type logical}, {"bank_class", type text}, {"is_savings_institution", type logical}, {"reported_owner_id", type text}, {"restated_owner_id", type text}, {"restate_method", type text}, {"deposits_capped_000", type number}, {"booking_status", type text}, {"deposits_adjusted_000", type number}})
				in
				  #"Changed column type"

	annotation PBI_ResultType = Table

